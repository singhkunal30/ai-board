# ─────────────────────────────────────────────────────────────────────────────
# AI-Board environment configuration
# Copy to `.env` and adjust. Never commit a real `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
# Public origin(s) allowed by CORS, comma-separated.
CORS_ORIGINS=http://localhost:3000

# ── PostgreSQL (with pgvector) ──────────────────────────────────────────────
POSTGRES_USER=aiboard
POSTGRES_PASSWORD=aiboard_dev_password
POSTGRES_DB=aiboard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Prisma reads DATABASE_URL directly.
DATABASE_URL=postgresql://aiboard:aiboard_dev_password@localhost:5432/aiboard?schema=public

# ── Redis (cache / pub-sub / rate-limit) ────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ── Object storage (S3-compatible / MinIO) ──────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ai-board
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ── Auth / JWT ──────────────────────────────────────────────────────────────
# Generate strong secrets: `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars-long
JWT_ACCESS_TTL=900            # 15 minutes (seconds)
JWT_REFRESH_TTL=2592000       # 30 days (seconds)

# ── AI provider (local LLMs) ────────────────────────────────────────────────
# Supported drivers: ollama | openai-compatible | mock
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434
AI_API_KEY=
AI_DEFAULT_CHAT_MODEL=qwen2.5:7b-instruct
AI_DEFAULT_EMBEDDING_MODEL=nomic-embed-text
AI_EMBEDDING_DIMENSIONS=768
AI_REQUEST_TIMEOUT_MS=120000

# ── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=debug               # trace|debug|info|warn|error
METRICS_ENABLED=true
