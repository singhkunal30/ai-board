// AI-Board database schema.
//
// Design notes:
//  * UUIDs (v4) as primary keys — globally unique, safe to expose, avoid
//    enumeration attacks that sequential ids invite.
//  * Soft-deletes via `deletedAt` on user-facing aggregates (Workspace, Board,
//    Document) so accidental deletes are recoverable and audit history holds.
//  * `pgvector` powers semantic retrieval (RAG). Embeddings live in their own
//    table so a single source object can have many chunked vectors.
//  * Every privileged mutation is recorded in AuditLog.
//  * Boards persist BOTH a CRDT binary (`yDocState`, authoritative for live
//    editing) and a JSON `snapshot` (cheap to read for REST / RAG / export).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, vector]
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum BoardRole {
  EDITOR
  COMMENTER
  VIEWER
}

enum BoardVisibility {
  PRIVATE // members explicitly granted access
  WORKSPACE // any workspace member can view/edit per their workspace role
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum EmbeddingSourceType {
  BOARD_OBJECT
  DOCUMENT_CHUNK
  COMMENT
  BOARD_SUMMARY
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique
  name         String
  passwordHash String?
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions         Session[]
  identities       OAuthIdentity[]
  memberships      WorkspaceMember[]
  boardMemberships BoardMember[]
  ownedWorkspaces  Workspace[]       @relation("WorkspaceOwner")
  createdBoards    Board[]           @relation("BoardCreator")
  comments         Comment[]
  uploadedDocs     Document[]
  auditLogs        AuditLog[]
  aiConversations  AiConversation[]

  @@index([email])
  @@map("users")
}

/// Refresh-token-backed sessions. The refresh JWT carries `jti = Session.id`;
/// rotating or revoking a session invalidates the token chain.
model Session {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model OAuthIdentity {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String // google | microsoft | oidc
  providerUserId String
  createdAt      DateTime @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_identities")
}

model Workspace {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String    @unique
  ownerId   String    @db.Uuid
  owner     User      @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  settings  Json      @default("{}")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  members   WorkspaceMember[]
  boards    Board[]
  documents Document[]
  auditLogs AuditLog[]
  aiConfig  AiModelConfig?

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String        @db.Uuid
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String        @db.Uuid
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Board {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String          @db.Uuid
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  description String?
  visibility  BoardVisibility @default(WORKSPACE)
  createdById String          @db.Uuid
  createdBy   User            @relation("BoardCreator", fields: [createdById], references: [id])

  /// CRDT binary state — authoritative document for live collaboration.
  yDocState Bytes?
  /// JSON projection of the latest board state for REST reads / export / RAG.
  snapshot  Json   @default("{\"schemaVersion\":1,\"objects\":[],\"edges\":[]}")
  /// Monotonic version, bumped on each persisted realtime store.
  version   Int    @default(0)

  isArchived Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  members         BoardMember[]
  comments        Comment[]
  aiConversations AiConversation[]

  @@index([workspaceId])
  @@index([workspaceId, isArchived])
  @@map("boards")
}

model BoardMember {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boardId   String    @db.Uuid
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      BoardRole @default(EDITOR)
  createdAt DateTime  @default(now())

  @@unique([boardId, userId])
  @@index([userId])
  @@map("board_members")
}

model Comment {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boardId    String    @db.Uuid
  board      Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  authorId   String    @db.Uuid
  author     User      @relation(fields: [authorId], references: [id])
  /// Optional anchor to a board object id (string id inside the snapshot).
  objectId   String?
  body       String
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([boardId])
  @@map("comments")
}

model Document {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String         @db.Uuid
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedById String        @db.Uuid
  uploadedBy  User           @relation(fields: [uploadedById], references: [id])
  filename    String
  mimeType    String
  sizeBytes   Int
  storageKey  String // object-store key (S3/MinIO)
  status      DocumentStatus @default(PENDING)
  error       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  @@index([workspaceId])
  @@map("documents")
}

/// Vector store for RAG. One row per chunk; `embedding` dimensionality must
/// match AI_EMBEDDING_DIMENSIONS (default 768 for nomic-embed-text).
model Embedding {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String              @db.Uuid
  boardId     String?             @db.Uuid
  sourceType  EmbeddingSourceType
  sourceId    String // id of the originating object/document/comment
  chunkIndex  Int                 @default(0)
  content     String
  metadata    Json                @default("{}")
  embedding   Unsupported("vector(768)")?
  createdAt   DateTime            @default(now())

  @@index([workspaceId])
  @@index([boardId])
  @@index([sourceType, sourceId])
  @@map("embeddings")
}

model AiModelConfig {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String    @unique @db.Uuid
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chatModel       String
  embeddingModel  String
  temperature     Float     @default(0.4)
  updatedAt       DateTime  @updatedAt

  @@map("ai_model_configs")
}

model AiConversation {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boardId   String?     @db.Uuid
  board     Board?      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId    String      @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentKind String      @default("assistant")
  title     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AiMessage[]

  @@index([boardId])
  @@index([userId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String         @db.Uuid
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant | system | tool
  content        String
  model          String?
  tokens         Int?
  createdAt      DateTime       @default(now())

  @@index([conversationId])
  @@map("ai_messages")
}

model AuditLog {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String?    @db.Uuid
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actorId     String?    @db.Uuid
  actor       User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action      String // e.g. board.create, workspace.member.add
  targetType  String
  targetId    String?
  metadata    Json       @default("{}")
  ipAddress   String?
  createdAt   DateTime   @default(now())

  @@index([workspaceId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
