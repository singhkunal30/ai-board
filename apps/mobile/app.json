{
  "expo": {
    "name": "AI-Board",
    "slug": "ai-board",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "aiboard",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0b0f1a"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.aiboard.app",
      "adaptiveIcon": {
        "backgroundColor": "#4f46e5"
      },
      "permissions": ["INTERNET"]
    },
    "extra": {
      "defaultApiUrl": "http://10.0.2.2:4000"
    },
    "plugins": []
  }
}
